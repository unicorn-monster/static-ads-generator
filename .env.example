# Kie AI (image/video generation)
KIE_API_KEY=

# Cloudinary (hosting reference/input images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive sync — ID of the "Dino IMG" parent folder.
# Open the folder in Drive; the ID is the last path segment of the URL:
# https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# OAuth client id/secret are NOT env vars — they live in credentials.json + token.json
# (both gitignored). See workflows/sync_to_drive.md for one-time setup.
