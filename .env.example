# Kie AI (image/video generation)
KIE_API_KEY=

# Cloudinary (hosting reference/input images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive sync — ID of the "Dino IMG" parent folder.
# Open the folder in Drive; the ID is the last path segment of the URL:
# https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Google OAuth creds for Drive sync.
# LOCAL: leave blank — the app reads token.json on disk (run scripts/gdrive-auth.mjs once).
# SERVERLESS (Vercel): token.json isn't deployed, so set these 3 from your token.json values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
